{
  "expo": {
    "name": "nf-fit",
    "slug": "nf-fit",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nffit",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.nffit.dogfood"
    },
    "android": {
      "package": "app.nffit.dogfood",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#F3F4F6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F3F4F6"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Камера нужна, чтобы считать штрихкод и сфотографировать этикетку с КБЖУ. Фото не уходят в облако.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Галерея нужна для фото рецепта и скрина заказа (Самокат/METRO). Фото и распознавание остаются на устройстве.",
          "cameraPermission": "Камера нужна для фото блюда и скрина заказа. Фото не уходят в облако."
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
